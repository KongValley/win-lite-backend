{
  "name": "win-lite-backend",
  "version": "1.0.0",
  "description": "Zero-dependency TypeScript REST backend for 32-bit and 64-bit Windows",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KongValley/win-lite-backend.git"
  },
  "bugs": {
    "url": "https://github.com/KongValley/win-lite-backend/issues"
  },
  "homepage": "https://github.com/KongValley/win-lite-backend#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "doctor": "npm run build && node dist/doctor.js",
    "clean:test": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\"",
    "test": "npm run clean:test && npm run build:test && node --test .test-dist/test/all.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pm2:start": "pm2 start ecosystem.config.json",
    "pm2:stop": "pm2 stop win-lite-backend",
    "pm2:restart": "pm2 restart win-lite-backend --update-env",
    "pm2:delete": "pm2 delete win-lite-backend",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs win-lite-backend",
    "pm2:save": "pm2 save"
  },
  "engines": {
    "node": ">=18.2.0"
  },
  "keywords": [
    "windows",
    "typescript",
    "rest",
    "api",
    "lightweight",
    "x86",
    "x64"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
