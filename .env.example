# 服务监听地址。0.0.0.0 表示允许局域网访问，仅本机使用可改为 127.0.0.1
HOST=0.0.0.0
PORT=3000

# 数据文件。相对路径基于项目根目录
DATA_FILE=data/tasks.json

# 跨域来源，多个来源用逗号分隔；* 表示允许所有来源，none 表示关闭 CORS
CORS_ORIGIN=*

# 可选 API Key。设置后，除 /、/api、/api/health 外的接口都需要鉴权
# 至少 16 个字符，建议使用随机值，例如：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_KEY=

# 内存限流：窗口内每个 IP 的最大请求数，设为 0 可关闭
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# 请求体大小上限（字节）
MAX_BODY_BYTES=1048576

# 仅当服务前面有可信反向代理时才设为 true
TRUST_PROXY=false

# debug | info | warn | error | silent
LOG_LEVEL=info

# 请求超时与请求头超时（毫秒）
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000

# 优雅关机的最大等待时间（毫秒）
SHUTDOWN_TIMEOUT_MS=10000
