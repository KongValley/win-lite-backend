{
  "apps": [
    {
      "name": "win-lite-backend",
      "script": "./dist/index.js",
      "cwd": ".",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": false,
      "wait_ready": true,
      "listen_timeout": 10000,
      "kill_timeout": 12000,
      "min_uptime": "5s",
      "max_restarts": 10,
      "restart_delay": 1000,
      "max_memory_restart": "256M",
      "merge_logs": true,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
